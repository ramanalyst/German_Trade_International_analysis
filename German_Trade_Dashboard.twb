          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Measure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Import in 1000 USD&quot;'>
              <calculation class='tableau' formula='&quot;Import in 1000 USD&quot;' />
